<!-- ПРОТОТИП (этап 1, Sheddy4/BeautyDesk#2). Одноразовый код, не для продакшена. -->
<Window x:Class="ShellRisksPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ПРОТОТИП BeautyDesk — трей и превью окон" Topmost="True"
        Width="1100" Height="330" WindowStyle="ToolWindow"
        Background="#181818" Foreground="#DDDDDD" FontFamily="Consolas" FontSize="12">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" Text="ТРЕЙ — левый и правый клик по иконке должны открывать родное меню программы" Foreground="#E0B060"/>
        <ItemsControl x:Name="TrayList" DockPanel.Dock="Top" Margin="0,4,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5" Margin="1" Background="#2A2A2A" ToolTip="{Binding Title}"
                            MouseEnter="Tray_MouseEnter" MouseLeave="Tray_MouseLeave" MouseMove="Tray_MouseMove"
                            MouseDown="Tray_MouseDown" MouseUp="Tray_MouseUp">
                        <Image Source="{Binding Icon}" Width="20" Height="20"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock DockPanel.Dock="Top" Text="ОКНА — наведи для живого превью, клик переключает на окно" Foreground="#E0B060"/>
        <ItemsControl x:Name="TaskList" DockPanel.Dock="Top" Margin="0,4,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5" Margin="1" Background="#2A2A2A"
                            MouseEnter="Task_MouseEnter" MouseLeave="Task_MouseLeave" MouseLeftButtonUp="Task_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Title}" MaxWidth="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBox x:Name="LogBox" IsReadOnly="True" Background="#101010" Foreground="#9FD09F" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    </DockPanel>
</Window>
