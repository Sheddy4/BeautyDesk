<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Версия Windows в имени нужна для доступа к сведениям о музыке (Windows.Media.Control). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms нужен библиотеке ManagedShell; без него самодостаточная сборка не запускается. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Масштаб экрана задан в app.manifest намеренно (режим «на каждый монитор»); совет Windows Forms перенести его не нужен. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>BeautyDesk.Program</StartupObject>
    <Version>0.1.1</Version>
    <Product>BeautyDesk</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.374" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Сами Windows Forms в коде не используются: убираем их имена, чтобы не путались с именами WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ui\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="themes\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
